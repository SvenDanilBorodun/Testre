# Default: let git handle line endings normally
* text=auto

# Files that MUST stay LF-only. Shell scripts get COPY'd into Linux Docker
# images and must not be corrupted by Windows CRLF conversion — PowerShell
# would happily accept CRLF, but /bin/sh refuses shebang lines with ^M.
*.sh                  text eol=lf
Dockerfile            text eol=lf
wsl.conf              text eol=lf
daemon.json           text eol=lf
docker-compose*.yml   text eol=lf
.s6-keep              text eol=lf
# Overlay targets — the apply_overlay() sha256 post-check matches the on-disk
# overlay byte-for-byte against the in-image file. CRLF drift on Windows hosts
# with core.autocrlf=true silently degrades that check to content-equivalence.
*.xacro               text eol=lf
*.yaml                text eol=lf
*.yml                 text eol=lf
# Version stamp + env template: read by Linux-side consumers (build_rootfs.sh
# bakes ROOTFS_VERSION into /etc/edubotics-rootfs-version; compose reads the
# .env the GUI derives from the template). Under bare `text=auto` a Windows
# checkout (installer CI runner, student dev box) materializes CRLF — the
# v2.6.1 installer shipped ROOTFS_VERSION as "1\r\n" and only survived
# because every current reader .Trim()s. Pin LF so no future reader needs to.
robotis_ai_setup/wsl_rootfs/ROOTFS_VERSION  text eol=lf
*.env.template        text eol=lf

# PowerShell scripts on Windows should stay CRLF or UTF-8+BOM (the scripts
# are explicitly saved with BOM to survive Windows PowerShell 5.1 parsing).
*.ps1                 text eol=crlf working-tree-encoding=UTF-8

# Binary — never convert
*.tar.gz              binary
*.vhdx                binary
*.png                 binary
*.jpg                 binary
*.ico                 binary
*.exe                 binary
# 7-Zip SFX self-extracting installer assets (offline image bundle). The stub
# is a Windows PE — keep it byte-exact. config.txt MUST stay CRLF: the CI
# `cat 7zSD.sfx config.txt archive.7z` concatenates it into the SFX and the
# config parser expects CRLF; bare `text=auto` would normalize it to LF in the
# repo and check it out LF on the Linux runner.
*.sfx                 binary
robotis_ai_setup/installer/sfx/config.txt  text eol=crlf
