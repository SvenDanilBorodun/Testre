# Environment files with secrets
robotis_ai_setup/cloud_training_api/.env
physical_ai_tools/physical_ai_manager/.env
robotis_ai_setup/docker/.env
robotis_ai_setup/docker/.env.build

# macOS
.DS_Store

# MCP server config (optional, per-checkout)
.mcp.json

# Build artifacts
robotis_ai_setup/gui/dist/
robotis_ai_setup/gui/build/
robotis_ai_setup/installer/output/
# build-images.sh staging copies of the server package + interfaces
# (regenerated next to the thin Dockerfile on every build — never source)
robotis_ai_setup/docker/physical_ai_server/pkg_src/
robotis_ai_setup/docker/physical_ai_server/interfaces/

# Bundled WSL2 rootfs tarball — produced by wsl_rootfs/build_rootfs.sh,
# ~200 MB compressed (exceeds GitHub 100 MB limit). Rebuild locally via:
#   cd robotis_ai_setup/wsl_rootfs && ./build_rootfs.sh
# The .sha256 sidecar is a build artifact too (regenerated every build).
robotis_ai_setup/installer/assets/*.tar.gz
robotis_ai_setup/installer/assets/*.tar.gz.sha256

# Supabase CLI local state
robotis_ai_setup/supabase/.temp/

# Python
__pycache__/
*.pyc

# Node
node_modules/

# Claude Code agent metadata (per-checkout, not project code)
.claude/
.audit-cache/

# Local audit scratch notes — per-session in-flight handoff docs that
# should not land on main. Move worth-keeping content into docs/ as a
# tracked file before deleting the local copy.
CRITICAL_FIXES.md

# Transient pre-build spec/plan one-pagers (leLab-style docs/superpowers
# pattern, adopted 2026-06-07): written BEFORE any feature touching >1 of
# the 10 layers, deleted after the feature ships. Deliberately untracked —
# permanent invariants belong in CLAUDE.md, not here.
docs/plans/

# Per-arm edu6 servo calibration records (tools/edu6_provision.py output).
# The Supabase edu6_arm_records table is the durable fleet store; these are
# local bench artifacts and must not accumulate per-arm files in the repo.
tools/edu6_records/
