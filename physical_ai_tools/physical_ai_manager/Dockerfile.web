# Railway-specific build for the teacher/admin web dashboard.
# Same source as the student Docker build, but with REACT_APP_MODE=web baked in
# and nginx configured to listen on Railway's dynamic $PORT.

FROM node:22 AS build
WORKDIR /app

# Build-time vars (Railway service variables are automatically passed as build args)
ARG REACT_APP_SUPABASE_URL
ARG REACT_APP_SUPABASE_ANON_KEY
ARG REACT_APP_CLOUD_API_URL
ARG REACT_APP_MODE=web
# Teacher/admin web deployment: expose every policy by default. Override via
# Railway variable REACT_APP_ALLOWED_POLICIES if you want to narrow it.
ARG REACT_APP_ALLOWED_POLICIES=tdmpc,diffusion,act,vqbet,pi0,pi0_fast,pi05,smolvla
# Build identifier (e.g. Railway commit SHA). Baked into the bundle and written
# to build/version.json so the running app can detect a new deploy and self-reload.
ARG REACT_APP_BUILD_ID=dev

# Promote to ENV so `npm run build` sees them via process.env.*
ENV REACT_APP_SUPABASE_URL=${REACT_APP_SUPABASE_URL} \
    REACT_APP_SUPABASE_ANON_KEY=${REACT_APP_SUPABASE_ANON_KEY} \
    REACT_APP_CLOUD_API_URL=${REACT_APP_CLOUD_API_URL} \
    REACT_APP_MODE=${REACT_APP_MODE} \
    REACT_APP_ALLOWED_POLICIES=${REACT_APP_ALLOWED_POLICIES} \
    REACT_APP_BUILD_ID=${REACT_APP_BUILD_ID}

COPY package*.json .npmrc* ./
# See note in Dockerfile: react-blockly@9 peer-dep is too narrow for React 19.
RUN npm install --legacy-peer-deps
COPY . .
# Same guard as the student Dockerfile — abort with a named cause if any
# Railway service variable wasn't passed through as a build-arg. Without
# this, an empty Railway secret produces a build that white-screens at
# runtime and the cause is buried in DevTools. See audit notes.
RUN test -n "$REACT_APP_SUPABASE_URL"      || (echo "ERROR: --build-arg REACT_APP_SUPABASE_URL is required (was empty)"      && exit 1) && \
    test -n "$REACT_APP_SUPABASE_ANON_KEY" || (echo "ERROR: --build-arg REACT_APP_SUPABASE_ANON_KEY is required (was empty)" && exit 1) && \
    test -n "$REACT_APP_CLOUD_API_URL"     || (echo "ERROR: --build-arg REACT_APP_CLOUD_API_URL is required (was empty)"     && exit 1)
# Source maps are disabled in vite.config.js (`build.sourcemap: false`) — they
# expose React source via DevTools and add ~15 MB to the shipped bundle. (This
# replaces CRA's GENERATE_SOURCEMAP=false env, which Vite does not read.)
# `npm run build` runs `vite build`.
RUN npm run build
RUN printf '{"buildId":"%s","builtAt":"%s"}\n' "${REACT_APP_BUILD_ID}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > build/version.json
# The Content Security Policy (F-46), built from the SAME two URLs the bundle
# just inlined, so it can never name another API or Supabase project. Outside
# build/ on purpose: it is configuration, not something to serve.
RUN node scripts/csp-policy.mjs > csp-policy.txt && cat csp-policy.txt

FROM nginx:1.27.5-alpine
COPY --from=build /app/build /usr/share/nginx/html

# nginx:alpine auto-runs envsubst on /etc/nginx/templates/*.template at startup.
# The filter limits substitution to $PORT and the two CSP variables, so $uri
# (etc.) in our conf is left alone. The CSP pair is exported by
# 18-edubotics-csp.envsh, which the entrypoint sources BEFORE its
# 20-envsubst-on-templates.sh: the policy from the file below, the header name
# from the runtime variable EDUBOTICS_CSP_ENFORCE (1 = enforce; anything else =
# report-only, the default).
COPY nginx.web.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/csp-policy.txt /etc/nginx/edubotics/csp-policy.txt
COPY nginx.web.csp.envsh /docker-entrypoint.d/18-edubotics-csp.envsh
RUN chmod 0755 /docker-entrypoint.d/18-edubotics-csp.envsh
ENV PORT=8080 \
    NGINX_ENVSUBST_FILTER="^(PORT|EDUBOTICS_CSP_HEADER|EDUBOTICS_CSP_POLICY)$"

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
