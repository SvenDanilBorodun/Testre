# Orange Pi 5 Pro nginx config for the `-opi` manager twin.
#
# This is a TEMPLATE (rendered by nginx:alpine's envsubst at container
# start) rather than a static file — unlike the plan's "static
# nginx.opi.conf" wording. Justification: the ONLY substituted token is
# ${EDUBOTICS_ROS_NET_GATEWAY}, the docker `ros_net` gateway the pi-agent
# listens on. That subnet is a managed `.env` key (P2) so the default
# 172.28.0.0/24 can be relocated off a colliding subnet
# (172.16.0.0/12 is common institutional space, and an overlap
# blackholes container->LAN routing) — the gateway must therefore be
# injectable at start, not baked.
#
# SCOPE OF THAT RELOCATION (measured, do not overstate it): the AUTOMATIC
# overlap check is bench-only — setup.sh's choose_ros_net_subnet() probes
# `ip -4 route` at PROVISIONING time, the choice freezes into the golden
# image, and every clone's first boot carries it forward verbatim (it cannot
# re-probe: it runs Before=network-online.target). So the subnet dodges the
# BENCH's LAN, never the deployment school's.
#
# A MANUAL relocation on a deployed rig DOES work, but ONLY with the robot
# tier stopped — and that caveat is the whole point of this paragraph:
#   * robot tier DOWN (a Pi's normal idle state): edit EDUBOTICS_ROS_NET_SUBNET
#     in the .env, then the agent's `up -d --force-recreate --no-deps
#     physical_ai_manager` recreates ros_net on the new subnet. The derived
#     gateway and this proxy_pass follow it; _gateway_binder_loop re-reads the
#     gateway every tick and rebinds. Verified end-to-end: clean exit, no 502.
#   * robot tier UP: the SAME command stops the manager, then FAILS to remove
#     the network ("has active endpoints"), exits non-zero, and leaves the
#     manager `exited` — restart:unless-stopped does not help (an explicit stop).
#     A retry fails differently ("container is not connected to the network")
#     and never recovers. The Pi's only UI is then gone until someone manually
#     intervenes. Always stop the robot tier before relocating the subnet.
# Dockerfile.opi sets
# NGINX_ENVSUBST_FILTER="^EDUBOTICS_ROS_NET_GATEWAY$" so nginx's own
# runtime vars ($host, $uri, $remote_addr, $proxy_add_x_forwarded_for,
# $scheme) — all single-$ — pass through untouched.
#
# The server{} block below is byte-for-byte the student nginx.conf
# (index.html/version.json no-store, /static/ immutable, SPA try_files
# fallthrough) PLUS four Pi-only locations: the baked /pi-mode.json
# marker, the /api/system/ reverse proxy to the pi-agent, and the
# /rosbridge + /video/ same-origin proxies into the physical_ai_server
# container. The latter two exist so a remote Chrome needs ONLY port 80:
# school networks routinely filter non-standard ports (9090/8080), and
# port 80 is the one port guaranteed reachable if the wizard loads at
# all. The React app routes rosbridge + MJPEG same-origin in Pi mode
# (utils/piMode.js localRosbridgeUrl/videoStreamBase); the direct host
# ports stay published in docker-compose.opi.yml as a LOOPBACK-PINNED
# DEBUG path only — `127.0.0.1:9090:9090` / `127.0.0.1:8080:8080`,
# reached with `ssh -L 9090:127.0.0.1:9090 <pi>`. The un-tunnelled LAN
# ROLLBACK half is gone (4d1b046): while those publishes were LAN-bound,
# rosbridge_server 2.7.0's `check_origin` — literally `return True` —
# made the /rosbridge Origin gate below SKIPPABLE rather than defeatable,
# measured at 101 with a working /leader/joint_trajectory session.
# WebSocket Connection-header map. Rendered into /etc/nginx/conf.d/default.conf,
# which nginx includes from http{} — so a map here is in the right context.
# Without it the /rosbridge location had to hardcode `Connection: upgrade`, which
# sent a bogus upgrade token on every NON-WebSocket request to that path. Both
# vars are single-$ and survive envsubst (NGINX_ENVSUBST_FILTER matches only
# EDUBOTICS_ROS_NET_GATEWAY).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# DNS-REBINDING GUARD for the /rosbridge gate below.
#
# That gate is HOST-RELATIVE — it accepts an Origin naming the same authority
# the request was addressed to — which is the only shape that works when a Pi
# is reached at whatever LAN IP or hostname the school gave it. But it accepts
# any authority the CLIENT chose: an attacker page on `http://attacker.example`
# whose DNS is rebound to the Pi's LAN IP sends `Host: attacker.example` AND
# `Origin: http://attacker.example`, the two match, and the gate opens.
# Measured 2026-08-08 against real rosbridge behind this template: 101, and the
# subsequent advertise of /leader/joint_trajectory took effect.
#
# So the HOST itself is constrained to shapes a Pi is actually reached at. This
# is deliberately GENEROUS — a fixed allowlist locks every Pi out, which is the
# standing rule for this file:
#   * `localhost` / IPv4 literal / bracketed IPv6 literal (a rebind cannot
#     produce these: an IP host is not a DNS name),
#   * a SINGLE-LABEL name (`edubotics`, `pi`) — a public DNS name always has a
#     dot, so single-label cannot be rebound from the internet,
#   * anything under `.local` — mDNS, which is link-local by definition.
# All with an optional :port.
#
# WHAT THIS REFUSES, and it is the one availability risk worth knowing: a
# multi-label name that is not `.local`, e.g. a school-managed
# `pi.schule.intern`. Such a rig answers 421 on /rosbridge only — the wizard,
# /api/system/ and the SPA are untouched, so the Pi is still reachable and
# repairable. Add the school's suffix as another entry here if that happens.
#
# Case-insensitive (~*) because $http_host preserves the case the client sent.
map $http_host $edubotics_host_is_own {
    default                                          0;
    "~*^localhost(:[0-9]+)?$"                        1;
    "~*^[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]+)?$"      1;
    "~*^\[[0-9a-f:.]+\](:[0-9]+)?$"                  1;
    "~*^[a-z0-9-]+(:[0-9]+)?$"                       1;
    "~*^[a-z0-9-]+(\.[a-z0-9-]+)*\.local(:[0-9]+)?$" 1;
}

server {
    listen 80;
    server_name localhost;

    # ── Security headers ─────────────────────────────────────────────────────
    # The opi manager is the ONLY one of the three manager builds published on
    # 0.0.0.0 by default (docker-compose.opi.yml binds ${EDUBOTICS_BIND_HOST}:80
    # and constants.DEFAULT_LAN_OPEN="1"), i.e. the most exposed and — until
    # now — the only one with no headers at all. The student nginx.conf omits
    # them because it is 127.0.0.1-bound; that reasoning does not carry here.
    # Mirrors nginx.web.conf.template's set, with ONE deliberate omission:
    #
    #   NO Strict-Transport-Security. The Pi serves plain HTTP on :80 with no
    #   TLS anywhere in front of it. RFC 6797 §7.2 requires a UA to IGNORE an
    #   STS header received over non-secure transport, so it would be a
    #   guaranteed no-op — and if a rig ever did get a cert, a stale two-year
    #   includeSubDomains max-age pinned to a LAN IP/.local name is a footgun,
    #   not a protection. The web dashboard sets it because Railway terminates
    #   TLS in front of it; nothing terminates TLS in front of a Pi.
    #
    # camera=()/microphone=()/geolocation=() are safe: the SPA never calls
    # getUserMedia (camera feeds are server-side MJPEG via <img>), and the web
    # build already ships this exact value from the same codebase. DENY is safe:
    # the app frames nothing of its own.
    #
    # `add_header` only inherits into a location that declares NO add_header of
    # its own, so every location below that sets Cache-Control MUST re-declare
    # these four. The proxy locations (/api/system/, /rosbridge, /video/) and the
    # SPA catch-all set none, so they inherit these correctly.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    # Docker's embedded DNS. The robot tier (physical_ai_server) is DOWN
    # at manager boot BY DESIGN, so the two proxies below must resolve
    # the upstream at REQUEST time, not config-load time: a literal
    # hostname in proxy_pass is resolved once at startup and would make
    # nginx fail to start (host not found) while the robot tier is down.
    # Variables (set $... below) defer resolution to per-request, and
    # valid=10s re-resolves after `--force-recreate` churns the
    # container IP. While the tier is down a request 502s in ms — the
    # SPA treats that exactly like "disconnected".
    resolver 127.0.0.11 valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    # HTML shell must never be cached — a new image pull needs to reach the
    # browser immediately so the hashed bundle references update without a
    # hard refresh.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        expires -1;
        # Re-declared: this block has its own add_header, so the server-level
        # security headers do NOT inherit into it (see the server block).
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    }

    # Build-id manifest polled by the React app to detect new deployments.
    # Must never be cached — the whole point is to read the current value.
    # Also the manager container's healthcheck target (docker-compose.opi.yml).
    location = /version.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        expires -1;
        # Re-declared — see the server block's add_header note.
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    }

    # Baked Pi-mode marker. The image IS the Pi flavor, so "is this a Pi"
    # is deterministic and independent of agent health — the P3 React
    # probe requires a valid JSON parse here to gate Pi-only UI (the
    # System tab, the StartupGate carve-out). The STUDENT nginx.conf has
    # NO such location, so on a non-Pi image /pi-mode.json falls through
    # the SPA catch-all to index.html and the JSON parse fails (Pi mode
    # stays off) — the same defensive fallthrough guard useVersionCheck
    # already relies on for /version.json.
    location = /pi-mode.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        # Re-declared — see the server block's add_header note.
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        return 200 '{"pi":true}';
    }

    # Same-origin reverse proxy to the pi-agent management API. The
    # trailing slash on proxy_pass STRIPS the /api/system/ prefix, so the
    # agent (bound on the docker gateway :8769) sees /status,
    # /roboter-studio/status, /roboter-studio/leader-enable, etc.
    # ${EDUBOTICS_ROS_NET_GATEWAY} is substituted by envsubst at start
    # (default 172.28.0.1, overridden per-rig by the opi compose).
    #
    # proxy_buffering off is MANDATORY here: the Protokoll SSE stream and
    # the MJPEG camera previews both ride this proxy, and nginx's defaults
    # (buffering on, 60s read timeout) would stall the former and freeze
    # the latter. chunked_transfer_encoding off + the long read/send
    # timeouts keep the long-lived streams flowing.
    location /api/system/ {
        proxy_pass http://${EDUBOTICS_ROS_NET_GATEWAY}:8769/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Forward Origin EXPLICITLY. The pi-agent's exact-host CSRF allowlist keys
        # on this header, so it is load-bearing and worth stating outright — but
        # note this line is a belt, not a fix: nginx forwards Origin by DEFAULT.
        # ngx_http_proxy_create_request copies every header in
        # r->headers_in.headers EXCEPT those in the merged headers.hash (this
        # location's own proxy_set_header set plus ngx_http_proxy_headers'
        # defaults). Adding a proxy_set_header does NOT drop the client's other
        # headers — an earlier revision of this comment claimed it did, which
        # would lead a maintainer to defensively re-declare every client header as
        # `proxy_set_header X $http_x`. Do NOT do that: it is how you actually
        # break things (an empty-valued proxy_set_header removes the header).
        # $http_origin is a single-$ runtime var (survives envsubst).
        proxy_set_header Origin $http_origin;
        # STRIP the agent's wildcard CORS header, for the same reason the
        # /video/stream block below strips web_video_server's.
        # `pi_agent/agent.py::Handler._cors` sets `Access-Control-Allow-Origin: *`
        # on EVERY JSON response, and GETs here are deliberately not
        # Origin-gated (only mutating routes are), so without this line any page
        # on the LAN could `fetch()` and READ /status, /protokoll,
        # /netzwerk-check and the /cameras/* preview cross-origin. Measured
        # 2026-08-08 against the real agent handler behind this template: lan_ip,
        # hostname, container_status and arms_identified all readable from
        # `Origin: http://evil.example`, while /video/stream on the same server
        # correctly stripped it.
        #
        # This does NOT weaken the agent: same-origin requests from our own SPA
        # never needed the header, since a same-origin fetch is not CORS.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding off;
    }

    # Same-origin WebSocket proxy to rosbridge inside the
    # physical_ai_server container (service DNS name on ros_net; the
    # published host port stays a debug fallback). The React app connects
    # to ws://<host>/rosbridge in Pi mode so the robot connection rides
    # port 80 — no school-firewall dependency on :9090. proxy_pass
    # carries an explicit URI ("/"): with a variable upstream nginx
    # passes that URI as-is, so rosbridge sees the "/" path it serves
    # its WebSocket handler on. $http_upgrade/$connection_upgrade are
    # single-$ vars and survive envsubst (filter only matches
    # EDUBOTICS_ROS_NET_GATEWAY). Long timeouts: an idle-but-alive
    # WebSocket must not be cut by the 60 s default. Connection comes from
    # the $connection_upgrade map at the top of this file rather than a
    # hardcoded "upgrade" — the hardcoded form sent a bogus upgrade token on
    # every non-WebSocket request that reached this path.
    #
    # ── Origin gate (2026-08-07) ────────────────────────────────────────────
    # THE control plane: anything speaking rosbridge here can drive a physical
    # arm standing beside children and read every recorded dataset. rosbridge
    # is UNAUTHENTICATED and `rosbridge_server` 2.7.0 OVERRIDES tornado's
    # same-origin default (`def check_origin(self, origin): return True`), so
    # without this gate any web page the student has open could open a session
    # and publish /leader/joint_trajectory. A WebSocket handshake has no CORS
    # preflight to stop it.
    #
    # HOST-RELATIVE, not an allowlist. The student nginx.conf names
    # `localhost`/`127.0.0.1` because gui_app opens exactly that URL; a Pi is
    # reached at whatever LAN IP or hostname the school gave it, so a fixed set
    # would lock every Pi out. The rule is instead: the Origin must name the
    # same AUTHORITY the request itself was addressed to.
    #
    # $http_host, NOT $host. Both were driven on nginx 1.27.5 and they differ in
    # exactly two places — neither of which is the one you would guess. On a Pi
    # served on :80 (the shipped layout) they agree, including on refusing
    # `Origin: http://<pi>:8080`. What separates them:
    #
    #   * A rig reached on a NON-DEFAULT port. With `Host: pi.local:8080`,
    #     $host is `pi.local`, so a page on `http://pi.local` — port 80, a
    #     DIFFERENT origin — is ACCEPTED, while the legitimate
    #     `http://pi.local:8080` is REFUSED. Measured: 200 and 403 respectively.
    #     $http_host gets both right (403 / 200).
    #   * An ABSOLUTE-FORM request line. $host is taken from the request line
    #     when there is one, so `GET http://evil.com/rosbridge` with
    #     `Host: pi.local` and `Origin: http://evil.com` is ACCEPTED under
    #     $host (measured 200) and refused under $http_host. No browser emits
    #     absolute-form, so this is not reachable from the attack this gate
    #     exists to stop — but it is a real bypass of the $host spelling and
    #     there is no reason to carry it.
    #
    # Both schemes are accepted for the same authority. Nothing terminates TLS
    # in front of a Pi today, and the property being enforced is host identity;
    # a page on the same authority is same-origin-enough for this gate whatever
    # scheme it was served over.
    #
    # EMPTY / ABSENT Origin is ALLOWED, deliberately and identically to the
    # student config: a browser cannot omit Origin on a WebSocket handshake —
    # it is set by the user agent, not by script — so a blank Origin provably
    # did not come from the attack this gate exists to stop, while denying it
    # would break roslibpy/wscat diagnostics. A `file://` page sends the
    # literal `null`, which is non-empty and therefore refused. This closes the
    # BROWSER path.
    #
    # THE RESIDUAL MOVED, and the old wording pointed at a port that is no
    # longer LAN-reachable. It used to read "a header-less LAN curl straight at
    # the published :9090"; 4d1b046 pinned the opi compose's :9090/:8080
    # publishes to `127.0.0.1:`, so that route is gone. The residual now lives
    # on THIS port: :80 is LAN-open by necessity (it is how a school reaches
    # the wizard at all), so a non-browser client on the LAN — curl, wscat,
    # roslibpy — can send whatever Origin it likes to /rosbridge here and drive
    # the arm.
    #
    # An Origin gate provably cannot stop that, and removing the empty-Origin
    # allowance does not change it: measured, `curl -H 'Host: <pi-ip>'
    # -H 'Origin: http://<pi-ip>' …/rosbridge` is still proxied, because Origin
    # is a BROWSER control set by the user agent and anything that can forge a
    # header can forge that one too. Accepted residual; the answer is the
    # dedicated-VLAN guide, not a tighter regex here.
    #
    # `if` here is the documented-safe shape: several `set`s feeding one
    # `return`, with proxy_pass OUTSIDE every `if`. Verified on nginx 1.27.5
    # (the base this image ships) that sibling `if` blocks each execute, that a
    # variable interpolates on the RIGHT of the `=` comparison, and that the
    # allowed case still proxies with Upgrade/Connection intact.
    #
    # KNOWN, DELIBERATE, AND FAIL-CLOSED: an uppercase `Host:` header with a
    # lowercase Origin (`Host: PI.LOCAL` + `Origin: http://pi.local`) is
    # REFUSED, because $http_host preserves case while browsers lowercase both.
    # No browser can produce that pair — the URL Standard lowercases the host
    # during parsing — and the failure is a loud 403 rather than a silent hole.
    # Using the lowercased $host to fix it would give up the port
    # discrimination above, which is the half that matters.
    location = /rosbridge {
        set $edubotics_origin_ok 0;
        if ($http_origin = "")                   { set $edubotics_origin_ok 1; }
        if ($http_origin = "http://$http_host")  { set $edubotics_origin_ok 1; }
        if ($http_origin = "https://$http_host") { set $edubotics_origin_ok 1; }
        # Host constrained FIRST in intent but LAST in placement, so the
        # `return 403` still follows every accepting `set` (that ordering is
        # itself fenced). A rebound Host answers 421 Misdirected Request, which
        # is both semantically right and distinguishable in a log from the 403
        # an ordinary cross-origin page gets.
        if ($edubotics_host_is_own = 0) {
            return 421;
        }
        if ($edubotics_origin_ok = 0) {
            return 403;
        }
        set $edubotics_rosbridge physical_ai_server;
        proxy_pass http://$edubotics_rosbridge:9090/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Same-origin proxy to web_video_server (MJPEG camera streams) in the
    # physical_ai_server container. The React app requests
    # /video/stream?topic=… in Pi mode instead of http://<host>:8080/…
    # — same port-80-only rationale as /rosbridge. The rewrite strips the
    # /video prefix (query string is preserved automatically) because a
    # variable proxy_pass cannot do prefix replacement itself.
    # proxy_buffering off is MANDATORY for multipart/x-mixed-replace —
    # nginx's default buffering would freeze the stream.
    #
    # EXACT match on /video/stream (2026-08-07), deliberately — NOT a `/video/`
    # prefix, which is what this was.
    #
    # Putting web_video_server on the SPA's OWN origin makes every endpoint it
    # serves same-origin too, and upstream's `handle_stream_viewer` reflects its
    # `topic` query parameter RAW into a text/html response:
    #
    #     ss << "<html><head><title>" << topic << "</title></head><body>";
    #
    # It validates `type` (the streamer factory) but never that the topic
    # exists, so /video/stream_viewer?type=mjpeg&topic=<script>… was a reflected
    # XSS on the Pi's OWN origin — precisely the Origin the /rosbridge gate
    # above now trusts. That would hand any such link a full rosbridge session
    # and the ability to publish /leader/joint_trajectory.
    #
    # The app only ever requests `<base>/stream?…` (piMode.js::videoStreamBase
    # returns the bare `/video`; ImageGridCell.js and CameraFeedOverlay.jsx are
    # its only callers), and nothing else on a Pi asks for a /video/ path — no
    # compose healthcheck, no pi-agent probe (the wizard's camera preview rides
    # /api/system/). So an exact-match location keeps the cameras working while
    # removing stream_viewer, the HTML index and every other upstream endpoint
    # from our origin. Adding a path back is a one-line change — but do it
    # deliberately, and check what that endpoint reflects.
    #
    # DELIBERATELY NOT Origin-gated, unlike /rosbridge, and that is not an
    # oversight. The app consumes these streams as `<img src=…>` and an image
    # load sends NO Origin header, so the gate could only ever fire on requests
    # the app does not make. What protects the pixels from cross-origin
    # JAVASCRIPT is the proxy_hide_header below, and it is REQUIRED, not
    # belt-and-braces: web_video_server sets `Access-Control-Allow-Origin: *` on
    # the very MultipartStream path this app uses, and nginx forwards an
    # upstream header it does not explicitly hide (ACAO is not in its default
    # hidden set). Left through, that wildcard lets any page `fetch()` a camera
    # frame and READ it — strictly worse than the `<img>` embed an Origin gate
    # also could not have stopped. Hiding it costs the app nothing: `<img>`
    # needs no CORS header at all. The Windows nginx.conf gained this on
    # 2026-08-06; the Pi — the only manager published on 0.0.0.0 by default —
    # did not, which is the parity gap this closes.
    location = /video/stream {
        set $edubotics_video physical_ai_server;
        rewrite ^/video/(.*)$ /$1 break;
        proxy_pass http://$edubotics_video:8080;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding off;
    }

    # Hashed JS/CSS bundles from CRA are content-addressed and safe to cache.
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        # Re-declared — see the server block's add_header note. nosniff matters
        # most here: these are the hashed JS/CSS bundles.
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    }

    # SPA routing — all paths fall through to index.html
    location / {
        try_files $uri /index.html;
    }
}
