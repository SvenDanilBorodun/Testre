# The teacher web's Content Security Policy (F-46, 2026-11-11). Both
# EDUBOTICS_CSP_* placeholders come from nginx.web.csp.envsh, which nginx:alpine's
# entrypoint sources before it renders this template: the policy the BUILD wrote
# from the bundle's own API and Supabase URLs (scripts/csp-policy.mjs), and the
# header name, Content-Security-Policy-Report-Only unless the Railway variable
# EDUBOTICS_CSP_ENFORCE is 1. Like the five headers below it is re-declared in
# every location that sets an add_header of its own.
#
# Violation reports (the policy's `report-uri /csp-report`) are written by nginx
# itself, one JSON-escaped line each, into the service log (Railway: the
# teacher-web service's logs, search „csp-report {": a report's line is
# `<time> csp-report {…}`, while nginx's error line for a REFUSED request only
# names `/csp-report` in its request line, see the location). nginx fills $request_body
# only for a body it read, so the location proxies the body to a sink server on
# a unix socket that answers 204. Rate-limited (behind Railway's proxy every
# client shares one address, so the bucket is effectively global) and capped at
# 16 KB a report.
log_format edubotics_csp_report escape=json '$time_iso8601 csp-report $request_body';
limit_req_zone $binary_remote_addr zone=edubotics_csp_report:1m rate=30r/m;

server {
    listen unix:/tmp/edubotics-csp-report.sock;
    access_log off;
    location / {
        return 204;
    }
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers applied to every response served by this vhost.
    # These previously lived in vercel.json, which is not the actual deploy
    # target — the web dashboard runs on Railway via Dockerfile.web + nginx,
    # so headers have to be set here to actually reach browsers.
    # HSTS: Railway terminates TLS and proxies plain HTTP to this container,
    # so the header is still honored by the browser. Two years + subdomains
    # matches typical hosted-app practice.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # Block framing: teacher/admin dashboard has never needed to be embedded
    # anywhere, and this is the cheapest clickjacking mitigation.
    add_header X-Frame-Options "DENY" always;
    # Stops browsers from MIME-sniffing responses into executable types.
    add_header X-Content-Type-Options "nosniff" always;
    # Keep referrer private when navigating away.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Block access to powerful web APIs the dashboard never uses. Blocks
    # malicious scripts (if any got injected) from quietly requesting
    # camera/mic/geo permission.
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # The CSP (top of this file). Its report-only form changes nothing a teacher
    # sees; the enforced form refuses whatever the policy does not name.
    add_header ${EDUBOTICS_CSP_HEADER} "${EDUBOTICS_CSP_POLICY}" always;

    # HTML shell must never be cached — new deploys need to reach the browser
    # immediately so footer/logo/text changes show up without a hard refresh.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        expires -1;
        # Re-declare security headers inside nested location blocks because
        # nginx's `add_header` only inherits when the inner block has *no*
        # add_header of its own. Without these repeats the server-level
        # headers would vanish on /index.html and /version.json responses.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header ${EDUBOTICS_CSP_HEADER} "${EDUBOTICS_CSP_POLICY}" always;
    }

    # Build-id manifest polled by the React app to detect new deployments.
    # Must never be cached — the whole point is to read the current value.
    location = /version.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        expires -1;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header ${EDUBOTICS_CSP_HEADER} "${EDUBOTICS_CSP_POLICY}" always;
    }

    # Hashed JS/CSS bundles from CRA are content-addressed and safe to cache.
    # All 5 security headers and the CSP MUST be re-declared — nginx's add_header
    # inheritance drops the server-level ones the moment this block
    # issues any add_header of its own (the Cache-Control line).
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header ${EDUBOTICS_CSP_HEADER} "${EDUBOTICS_CSP_POLICY}" always;
    }

    # CSP violation reports (the policy's report-uri; POST only, sent by the
    # browser without credentials). Logged with the edubotics_csp_report format
    # at the top of this file instead of the ordinary access log line, and
    # ONLY when nginx read a body (`if=$request_body`, VB-06 2026-11-15): a
    # refused request (403 for another method, 413 too large, 429 over the
    # rate) and an empty POST write no ACCESS-log line, never an empty
    # „csp-report" line. nginx still writes its usual ERROR-log line for a
    # refused one — `access forbidden by rule`, `client intended to send too
    # large body` or `limiting requests`, with `request: "<METHOD> /csp-report
    # HTTP/1.1"` and the client address, never the body (verification round C,
    # VC-09). That line is kept on purpose: an `error_log /dev/null` here would
    # also hide a broken sink socket. A REPORT is the access line
    # `<time> csp-report {…}`; search for „csp-report {". No add_header here,
    # so the server-level headers apply.
    location = /csp-report {
        limit_except POST { deny all; }
        limit_req zone=edubotics_csp_report burst=30 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
        client_body_buffer_size 16k;
        access_log /var/log/nginx/access.log edubotics_csp_report if=$request_body;
        proxy_pass http://unix:/tmp/edubotics-csp-report.sock:/;
    }

    # SPA routing — all paths fall through to index.html
    location / {
        try_files $uri /index.html;
    }
}
