  "types": [
    {
      "name": "Greifziel",
      "java_name": "Robot.Greifziel",
      "doc_de": "Ein gefundenes Objekt: find liefert es, die Greif-Schritte (über das Objekt fahren, absenken, schließen, erledigt) nehmen es.",
      "example_py": "ziel = robot.find(\"wuerfel\")\nif ziel is not None:\n    robot.move_above(ziel)\n    robot.descend_to(ziel)\n    robot.close_on_object(ziel)\n    robot.lift()\n    robot.mark_done(ziel)",
      "example_java": "Robot.Greifziel ziel = Robot.find(\"wuerfel\");\nif (ziel != null) {\n    Robot.moveAbove(ziel);\n    Robot.descendTo(ziel);\n    Robot.closeOnObject(ziel);\n    Robot.lift();\n    Robot.markDone(ziel);\n}"
    },
    {
      "name": "Greifobjekt",
      "java_name": "Greifobjekt",
      "doc_de": "Ein eigener Objekt-Typ für diesen Lauf: Name, AprilTag-Nummern, Höhe und Greiftiefe – danach greift grasp ihn wie einen Würfel.",
      "example_py": "class Banane(robot.Greifobjekt):\n    tag_ids = [30, 31]\n    hoehe_m = 0.040\n    greiftiefe_m = 0.015\n\nrobot.grasp(Banane)",
      "example_java": "edubotics.Greifobjekt banane = new edubotics.Greifobjekt(\"Banane\", new int[] {30, 31}, 0.040, 0.015);\nRobot.grasp(banane);"
    }
  ]
