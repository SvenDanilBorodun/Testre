FROM robotis/ros:jazzy-ros-base-torch2.7.0-cuda12.8.0 AS physical-ai-tools

ARG S6_OVERLAY_VERSION=3.2.1.0

# Install s6-overlay
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-aarch64.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-aarch64.tar.xz

RUN echo 'export PATH=/opt/venv/bin:$PATH' >> /root/.bashrc && \
    echo 'export PYTHONPATH=/opt/venv/lib/python3.12/site-packages:$PYTHONPATH' >> /root/.bashrc && \
    export PATH=/opt/venv/bin:$PATH && \
    export PYTHONPATH=/opt/venv/lib/python3.12/site-packages:$PYTHONPATH;

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Install realsense and physical_ai_tools dependencies
RUN apt-get update && apt-get install -y \
    xz-utils \
    ffmpeg \
    vim \
    nano \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

ENV COLCON_WS=/root/ros2_ws
WORKDIR ${COLCON_WS}

# SHA-pinned physical_ai_tools clone (Rule §5, 5-site LeRobot contract).
#
# Why pinned: the previous `git clone -b jazzy --recursive` tracked the moving
# jazzy branch tip, so every rebuild could silently pick up a new LeRobot
# submodule SHA. The amd64 base image (robotis/physical-ai-server:amd64-0.8.2,
# registry-pinned) freezes a known-good state by virtue of being a fixed tag;
# this arm64 base did NOT until this pin landed.
#
# The pin (577371eb..., commit "Bump 0.8.3", 2026-04-30) was chosen because
# its lerobot submodule entry is exactly:
#   989f3d05ba47f872d75c587e76838e9cc574857a
# — which matches modal_app.py::LEROBOT_COMMIT and the static lerobot snapshot
# at physical_ai_tools/lerobot/ in this repo. Verified via:
#   curl https://api.github.com/repos/ROBOTIS-GIT/physical_ai_tools/contents/\
#        lerobot?ref=577371eb75df552c50e15a379365f0d8821a9361
#
# The runtime SHA-check below is the load-bearing guard — if a future bump
# moves either SHA out of sync, the arm64 build fails loudly here instead of
# shipping a silently-drifted LeRobot that crashes inside the LeRobot v2.1
# preflight on a Jetson at a student's bench.
ARG PHYSICAL_AI_TOOLS_REF=577371eb75df552c50e15a379365f0d8821a9361
ARG LEROBOT_EXPECTED_SHA=989f3d05ba47f872d75c587e76838e9cc574857a
RUN set -e && \
    mkdir -p ${COLCON_WS}/src && \
    cd ${COLCON_WS}/src && \
    git clone https://github.com/ROBOTIS-GIT/physical_ai_tools.git && \
    cd physical_ai_tools && \
    git checkout "${PHYSICAL_AI_TOOLS_REF}" && \
    git submodule update --init --recursive && \
    actual_lerobot_sha="$(git -C lerobot rev-parse HEAD)" && \
    if [ "${actual_lerobot_sha}" != "${LEROBOT_EXPECTED_SHA}" ]; then \
        echo "::error::LeRobot submodule SHA drift at physical_ai_tools@${PHYSICAL_AI_TOOLS_REF}:"; \
        echo "::error::  expected ${LEROBOT_EXPECTED_SHA}"; \
        echo "::error::  got      ${actual_lerobot_sha}"; \
        echo "::error::Bump PHYSICAL_AI_TOOLS_REF to a parent commit whose lerobot submodule matches Rule §5."; \
        exit 1; \
    fi && \
    echo "LeRobot SHA verified: ${actual_lerobot_sha} (matches Rule §5 contract)"

RUN cd ${COLCON_WS} && \
    apt-get update && \
    rosdep update && \
    rosdep install -i --from-path src --rosdistro $ROS_DISTRO -y && \
    rm -rf /var/lib/apt/lists/*

ENV PIP_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126/+simple
ENV PIP_EXTRA_INDEX_URL=https://pypi.org/simple

RUN cd ${COLCON_WS}/src/physical_ai_tools/lerobot && \
    sed -i '/"torch[^\"]*",/d' pyproject.toml && \
    sed -i '/"torchvision[^\"]*",/d' pyproject.toml && \
    pip install --ignore-installed -e .

RUN cd ${COLCON_WS}/src/physical_ai_tools/lerobot && \
    pip install -e ".[smolvla]"

RUN pip install --no-cache-dir setuptools==68.1.2
RUN pip install --no-cache-dir 'numpy<2'

# Cross-arch package floor — pin safetensors / protobuf / pillow to the same
# version on BOTH arches. The 2026-05 audit caught arm64 silently resolving
# safetensors==0.8.0rc (pre-release!), protobuf==7.x, and pillow==12.2 while
# amd64 stayed on 0.7 / 6.x / 12.1. None breaks the pipeline today, but
# `protobuf 6 → 7` is the classic "works on x86, fails on Jetson arm64" pattern
# (proto plugin ABI changes are routinely opaque). Pin to the lower common
# denominator that ships as stable on BOTH arches AND matches LeRobot's
# grpcio-dep contract (lerobot/pyproject.toml: protobuf==6.31.0).
#
#   safetensors==0.7.0   (last non-RC; 0.8 is still rc0/dev as of 2026-05)
#   protobuf==6.31.0     (matches LeRobot grpcio-dep pin; onnx>=1.16 needs
#                         protobuf>=4.25 so 6.x is fine)
#   pillow==12.1.0       (LCD across arches; both amd64 and arm64 wheel-
#                         available; feature-set identical to 12.2)
#
# Installed AFTER the LeRobot install + numpy pin so this overrides any
# transitive resolution. `--force-reinstall` ensures the wheels actually get
# swapped in even when the resolver thinks a satisfying version is present.
# Mirrored in robotis_ai_setup/docker/physical_ai_server/Dockerfile for amd64
# (the thin overlay over robotis/physical-ai-server:amd64-0.8.2).
RUN pip install --no-cache-dir --force-reinstall \
        safetensors==0.7.0 \
        protobuf==6.31.0 \
        pillow==12.1.0 && \
    python3 -c "import safetensors, google.protobuf, PIL; \
                print('cross-arch floor:', safetensors.__version__, \
                      google.protobuf.__version__, PIL.__version__)"

RUN echo 'export PYTHONPATH=${COLCON_WS}/src/physical_ai_tools/lerobot/src:$PYTHONPATH' >> /root/.bashrc && \
    export PYTHONPATH=${COLCON_WS}/src/physical_ai_tools/lerobot/src:$PYTHONPATH;

RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    cd ${COLCON_WS} && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release"

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc  && \
    echo "source ${COLCON_WS}/install/setup.bash" >> ~/.bashrc  && \
    echo "alias cb='colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release'" >> ~/.bashrc && \
    echo "alias ai_server='ros2 launch physical_ai_server physical_ai_server_bringup.launch.py'" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=30" >> ~/.bashrc

# Create directory for agent Unix Domain Socket
RUN mkdir -p /var/run/agent && \
    chmod 777 /var/run/agent

# talos_system_manager — kept here ONLY because its requirements.txt installs
# shared pip deps into site-packages that other packages reuse. The directory
# itself + the PYTHONPATH entry are stripped from the production image by the
# thin-overlay Dockerfile in robotis_ai_setup/docker/physical_ai_server/, so
# nothing depends on /opt/talos_system_manager existing at runtime.
#
# SHA-pinned (commit "BUMP 0.1.2", 2026-02-05) so the requirements.txt list
# can't shift under us between builds. Only the pip-installed packages persist
# into the production image (the directory itself is stripped). Bumping this
# pin is safe as long as the new commit's requirements.txt resolves cleanly
# alongside the LeRobot deps installed in the layers above.
ARG TALOS_SYSTEM_MANAGER_REF=40981c6d15a1e0f1cba9e3d424fe292833c1b7f9
RUN set -e && \
    git clone https://github.com/ROBOTIS-GIT/talos_system_manager.git /opt/talos_system_manager && \
    git -C /opt/talos_system_manager checkout "${TALOS_SYSTEM_MANAGER_REF}" && \
    echo "talos_system_manager pinned to ${TALOS_SYSTEM_MANAGER_REF}"

ENV PYTHONPATH=/opt/talos_system_manager:${PYTHONPATH}

RUN pip install --no-cache-dir -r /opt/talos_system_manager/requirements.txt

# s6-rc services: s6-agent, physical_ai_server (longrun + log pipeline)
COPY docker/s6-agent /etc/s6-overlay/s6-rc.d/s6-agent
COPY docker/s6-services /etc/s6-overlay/s6-rc.d/
RUN rm -rf /etc/s6-overlay/s6-rc.d/common
RUN chmod +x /etc/s6-overlay/s6-rc.d/s6-agent/run /etc/s6-overlay/s6-rc.d/s6-agent/finish \
    /etc/s6-overlay/s6-rc.d/physical_ai_server/run /etc/s6-overlay/s6-rc.d/physical_ai_server/finish \
    /etc/s6-overlay/s6-rc.d/physical_ai_server-log/run

# Copy reusable ROS2 service scripts to a location outside s6-rc.d
# This prevents s6-rc-compile from treating them as services
RUN mkdir -p /usr/local/lib/s6-services
COPY docker/s6-services/common/ros2_service_run.sh /usr/local/lib/s6-services/ros2_service_run.sh
COPY docker/s6-services/common/ros2_service_finish.sh /usr/local/lib/s6-services/ros2_service_finish.sh
RUN chmod +x /usr/local/lib/s6-services/ros2_service_run.sh && \
    chmod +x /usr/local/lib/s6-services/ros2_service_finish.sh

# Create log directory and set permissions
RUN mkdir -p /var/log/physical_ai_server && \
    chown nobody:nogroup /var/log/physical_ai_server && \
    chmod 02755 /var/log/physical_ai_server

RUN mkdir -p /etc/s6-overlay/s6-rc.d/user/contents.d && \
    touch /etc/s6-overlay/s6-rc.d/user/contents.d/s6-agent

# Set s6-overlay as entrypoint
ENTRYPOINT ["/init"]
