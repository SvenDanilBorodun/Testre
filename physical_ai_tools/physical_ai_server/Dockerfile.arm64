FROM robotis/ros:jazzy-ros-base-torch2.7.0-cuda12.8.0 AS physical-ai-tools

ARG S6_OVERLAY_VERSION=3.2.1.0

# Install s6-overlay
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-aarch64.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-aarch64.tar.xz

RUN echo 'export PATH=/opt/venv/bin:$PATH' >> /root/.bashrc && \
    echo 'export PYTHONPATH=/opt/venv/lib/python3.12/site-packages:$PYTHONPATH' >> /root/.bashrc && \
    export PATH=/opt/venv/bin:$PATH && \
    export PYTHONPATH=/opt/venv/lib/python3.12/site-packages:$PYTHONPATH;

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Install realsense and physical_ai_tools dependencies
RUN apt-get update && apt-get install -y \
    xz-utils \
    ffmpeg \
    vim \
    nano \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

ENV COLCON_WS=/root/ros2_ws
WORKDIR ${COLCON_WS}

# v2.5.0: LeRobot is installed from PyPI (see next RUN), not from a submodule.
# The clone provides only the ROS Python packages (physical_ai_interfaces,
# physical_ai_server source) that colcon builds below. Stripping the lerobot
# subdir prevents any v0.2.0 import path from bleeding into the runtime image.
RUN mkdir -p ${COLCON_WS}/src && \
    cd ${COLCON_WS}/src && \
    git clone --depth 1 -b jazzy https://github.com/ROBOTIS-GIT/physical_ai_tools.git && \
    rm -rf physical_ai_tools/lerobot

RUN cd ${COLCON_WS} && \
    apt-get update && \
    rosdep update && \
    rosdep install -i --from-path src --rosdistro $ROS_DISTRO -y && \
    rm -rf /var/lib/apt/lists/*

ENV PIP_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126/+simple
ENV PIP_EXTRA_INDEX_URL=https://pypi.org/simple

# LeRobot v0.5.1 from PyPI via the Jetson AI Lab pip index (set as ENV above).
# Falls through to PyPI for any wheel the Jetson index doesn't carry. Extras:
#   [pi0]      pulls PI0Policy + PI0FastPolicy deps
#   [smolvla]  pulls transformers==5.3.0 + SmolVLM deps; transitively covers
#              pi05 (Pi-0.5, new in v0.5.1)
#   [peft]     pulls PeftConfig/PeftModel for cfg.use_peft branch
#
# numpy<2 pin DROPPED: v0.5.1 requires numpy>=2.0,<2.3. setuptools 68 pin
# DROPPED: not needed for the PyPI install.
#
# IMPORTANT: SmolVLA is currently broken on Jetson Orin ARM64 (upstream bug
# #3636: pyav vs torchcodec decoder discrepancy produces wrong actions vs
# x86_64). Phase 3's inference_manager.py hides SmolVLA from the React
# dropdown on aarch64 hosts. The dep is installed anyway — students on
# x86 connected to a Jetson via rosbridge can still ask the Jetson to load
# a SmolVLA model in principle, just blocked by the dropdown gate.
# scipy is pinned explicitly (v2.5.1 audit): it is otherwise only a transitive
# of the lerobot[pi] extra and that resolve proved non-deterministic across
# builds — pi0_fast inference hard-needs scipy.fftpack.idct, so pin it directly.
RUN python3 -m pip uninstall -y torchcodec 2>/dev/null || true && \
    pip install --no-cache-dir \
        "lerobot[pi,smolvla,peft]==0.5.1" \
        "accelerate>=1.10.0,<2.0.0" \
        "scipy>=1.14.0,<2.0.0"

# Cross-arch package floor — pin safetensors / protobuf / pillow to a single
# version on BOTH arches. v0.5.1 resolves these naturally to compatible versions,
# but we pin explicitly to keep amd64 + arm64 producing byte-identical
# site-packages for these libs. Versions chosen from Phase 0's verified pip
# resolve of `lerobot[pi,smolvla,peft]==0.5.1` on Python 3.12.
#
#   safetensors==0.7.0   (unchanged; still the LCD across arches)
#   protobuf==6.33.6     (bumped from 6.31.0; v0.5.1's grpcio-dep wants 6.31+)
#   pillow==12.2.0       (bumped from 12.1.0; v0.5.1 resolves here)
#
# Mirrored in robotis_ai_setup/docker/physical_ai_server/Dockerfile (the thin
# overlay that runs over either base image).
# numpy==1.26.4 added v2.5.4: cv_bridge_boost.so is built against NumPy 1.x, so
# lerobot's numpy>=2 segfaults the recording/inference rgb8 decode path. Pin <2.
RUN pip install --no-cache-dir --force-reinstall \
        safetensors==0.7.0 \
        protobuf==6.33.6 \
        pillow==12.2.0 \
        numpy==1.26.4 && \
    python3 -c "import safetensors, google.protobuf, PIL, numpy; \
                print('cross-arch floor:', safetensors.__version__, \
                      google.protobuf.__version__, PIL.__version__, numpy.__version__); \
                assert numpy.__version__.startswith('1.'), 'numpy must be <2 for cv_bridge ABI'"

# v2.5.0: LeRobot is in site-packages, not under physical_ai_tools/lerobot/src.
# The historic PYTHONPATH entry is no longer needed.

RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    cd ${COLCON_WS} && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release"

# Build-time policy import smoke test. Catches a LeRobot module-layout drift
# at `docker buildx build` time instead of at student-bench inference time.
# Imports every policy modeling module that inference_manager.py lazy-loads,
# plus the v0.5.1 inference helpers and v3.0 dataset I/O symbols. If any of
# these fail (a future LeRobot release reorganises modules without bumping
# our pin via PyPI's preview channel), the image build aborts loudly.
RUN python3 -c "\
import lerobot; print(f'lerobot=={lerobot.__version__}'); \
from lerobot.policies.act.modeling_act import ACTPolicy; \
from lerobot.policies.diffusion.modeling_diffusion import DiffusionPolicy; \
from lerobot.policies.tdmpc.modeling_tdmpc import TDMPCPolicy; \
from lerobot.policies.vqbet.modeling_vqbet import VQBeTPolicy; \
from lerobot.policies.pi0.modeling_pi0 import PI0Policy; \
from lerobot.policies.pi0_fast.modeling_pi0_fast import PI0FastPolicy; \
from lerobot.policies.pi05.modeling_pi05 import PI05Policy; \
from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy; \
from lerobot.utils.control_utils import predict_action; \
from lerobot.policies.factory import make_pre_post_processors; \
from lerobot.datasets.feature_utils import validate_frame; \
from lerobot.datasets.io_utils import write_info, write_episodes, write_stats; \
from lerobot.datasets.dataset_metadata import CODEBASE_VERSION; \
assert CODEBASE_VERSION == 'v3.0', f'unexpected codebase_version: {CODEBASE_VERSION}'; \
print('all v0.5.1 imports OK; codebase_version=v3.0')"

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc  && \
    echo "source ${COLCON_WS}/install/setup.bash" >> ~/.bashrc  && \
    echo "alias cb='colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release'" >> ~/.bashrc && \
    echo "alias ai_server='ros2 launch physical_ai_server physical_ai_server_bringup.launch.py'" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=30" >> ~/.bashrc

# Create directory for agent Unix Domain Socket
RUN mkdir -p /var/run/agent && \
    chmod 777 /var/run/agent

# talos_system_manager — kept here ONLY because its requirements.txt installs
# shared pip deps into site-packages that other packages reuse. The directory
# itself + the PYTHONPATH entry are stripped from the production image by the
# thin-overlay Dockerfile in robotis_ai_setup/docker/physical_ai_server/, so
# nothing depends on /opt/talos_system_manager existing at runtime.
#
# SHA-pinned (commit "BUMP 0.1.2", 2026-02-05) so the requirements.txt list
# can't shift under us between builds. Only the pip-installed packages persist
# into the production image (the directory itself is stripped). Bumping this
# pin is safe as long as the new commit's requirements.txt resolves cleanly
# alongside the LeRobot deps installed in the layers above.
ARG TALOS_SYSTEM_MANAGER_REF=40981c6d15a1e0f1cba9e3d424fe292833c1b7f9
RUN set -e && \
    git clone https://github.com/ROBOTIS-GIT/talos_system_manager.git /opt/talos_system_manager && \
    git -C /opt/talos_system_manager checkout "${TALOS_SYSTEM_MANAGER_REF}" && \
    echo "talos_system_manager pinned to ${TALOS_SYSTEM_MANAGER_REF}"

ENV PYTHONPATH=/opt/talos_system_manager:${PYTHONPATH}

RUN pip install --no-cache-dir -r /opt/talos_system_manager/requirements.txt

# s6-rc services: s6-agent, physical_ai_server (longrun + log pipeline)
COPY docker/s6-agent /etc/s6-overlay/s6-rc.d/s6-agent
COPY docker/s6-services /etc/s6-overlay/s6-rc.d/
RUN rm -rf /etc/s6-overlay/s6-rc.d/common
RUN chmod +x /etc/s6-overlay/s6-rc.d/s6-agent/run /etc/s6-overlay/s6-rc.d/s6-agent/finish \
    /etc/s6-overlay/s6-rc.d/physical_ai_server/run /etc/s6-overlay/s6-rc.d/physical_ai_server/finish \
    /etc/s6-overlay/s6-rc.d/physical_ai_server-log/run

# Copy reusable ROS2 service scripts to a location outside s6-rc.d
# This prevents s6-rc-compile from treating them as services
RUN mkdir -p /usr/local/lib/s6-services
COPY docker/s6-services/common/ros2_service_run.sh /usr/local/lib/s6-services/ros2_service_run.sh
COPY docker/s6-services/common/ros2_service_finish.sh /usr/local/lib/s6-services/ros2_service_finish.sh
RUN chmod +x /usr/local/lib/s6-services/ros2_service_run.sh && \
    chmod +x /usr/local/lib/s6-services/ros2_service_finish.sh

# Create log directory and set permissions
RUN mkdir -p /var/log/physical_ai_server && \
    chown nobody:nogroup /var/log/physical_ai_server && \
    chmod 02755 /var/log/physical_ai_server

RUN mkdir -p /etc/s6-overlay/s6-rc.d/user/contents.d && \
    touch /etc/s6-overlay/s6-rc.d/user/contents.d/s6-agent

# Set s6-overlay as entrypoint
ENTRYPOINT ["/init"]
