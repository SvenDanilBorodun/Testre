SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Public anon key — stored in the Modal Secret `edubotics-training-secrets`
# so the training worker can call update_training_progress() scoped by worker_token.
# Never gives raw table access.
SUPABASE_ANON_KEY=eyJ...
# Modal service-user token (Workspace Settings → Service Users).
# Used by this Railway service to dispatch training jobs via the Modal SDK.
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...
MODAL_TRAINING_APP_NAME=edubotics-training
MODAL_TRAINING_FUNCTION_NAME=train
HF_TOKEN=hf_your_huggingface_token
# Comma-separated list of allowed origins for CORS.
# Include the teacher/admin web URL (Vercel/Railway-static) when deployed.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://your-teacher-dashboard.vercel.app
# 042 — per-student Hugging Face token storage. REQUIRED: 32 random bytes, standard base64:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Absent, empty or malformed: the API refuses to boot (like SUPABASE_URL). Set it BEFORE the deploy.
# Rotation: put the NEW key in EDUBOTICS_HF_TOKEN_KEY and move the old one to
# EDUBOTICS_HF_TOKEN_KEY_PREVIOUS. Drop PREVIOUS only when no student still depends on it
# (POST /me/hf-token/verify re-encrypts a token under the current key; a token whose key is gone
# reads as "usable":false and the student saves it again).
EDUBOTICS_HF_TOKEN_KEY=
EDUBOTICS_HF_TOKEN_KEY_PREVIOUS=
# ─── Managed ACT training (migration 049; spec §3.8) ────────────────────────
# `legacy` (default): every training goes to Modal as before. `managed`: new ACT
# trainings go through RunPod, cheapest first (Community in any region, then Secure
# in the EU GDPR data centres, then Secure anywhere; owner E42); only with
# `MANAGED_MODAL_RUNG=1` (emergency) a Modal rung follows, last. The managed loops
# also run under `legacy` while a managed row is still active.
TRAINING_DISPATCH=legacy
# Required with TRAINING_DISPATCH=managed (the boot names what is missing):
TRAINING_WORKER_API_URL=https://your-cloud-api.up.railway.app
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# HF_TOKEN above must be able to WRITE to EduBotics-Solutions (the API publishes the model).
# Required when the ladder has a RunPod rung (pods: read + write, catalog: read):
RUNPOD_API_KEY=
# Set by release.yml (digest-pinned): ghcr.io/svendanilborodun/edubotics-trainer:<VERSION>@sha256:<64 hex>
RUNPOD_TRAINER_IMAGE=
# Optional:
#TRAINING_WORKER_SUPABASE_URL=   (default: SUPABASE_URL)
#R2_KEY_PREFIX=train/
#RUNPOD_API_BASE=https://api.runpod.io
#RUNPOD_LADDER=[{"rung":"runpod_secure","gpus":[{"id":"NVIDIA RTX A5000","min_vcpu":8}]}]   (default: Community 13 cards → Secure 7 cards; modal only with MANAGED_MODAL_RUNG=1, last)
#MANAGED_MODAL_RUNG=0                 (1 = emergency: the Modal rung returns as the last rung; a MANAGED_ACT_CAP_S above 23520 is then clamped with a WARNING)
#RUNPOD_POD_PREFIX=edubotics-train
#MAX_RUNPOD_PODS=30
#TRAINING_START_DEADLINE_S=1200
#MANAGED_ACT_CAP_S=12600            (3.5 h of training time per credit, owner E32; ≤ 43200; with MANAGED_MODAL_RUNG=1 clamped to 23520)
#R2_KEEP_PREFIX=keep/               (the 7-day continuable checkpoint; must end with / and not overlap R2_KEY_PREFIX; bucket rule: keep/ after 9 days)
#MODAL_TRAINING_MANAGED_FUNCTION_NAME=train_managed
# NEVER in production: TRAINING_SAVE_FREQ / TRAINING_MIRROR_EVERY (only together with TRAINING_E2E=1)
