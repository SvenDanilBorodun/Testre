# Template only — the Windows GUI generates the real .env at
# %LOCALAPPDATA%\EduBotics\.env (handed to compose via --env-file).
FOLLOWER_PORT="/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_XXXX"
LEADER_PORT="/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_YYYY"
# Roles MUST be gripper/scene (omx_f_config.yaml hard-codes the topics).
# native_bridge (WSL2 student default): leave CAMERA_DEVICE_* empty — the GUI
# streams JPEG frames in over TCP. usb_cam (Jetson / native Linux): set the
# /dev/video* (or /dev/v4l/by-path/*) device paths.
CAMERA_DEVICE_1=""
CAMERA_NAME_1="gripper"
CAMERA_DEVICE_2=""
CAMERA_NAME_2="scene"
ROS_DOMAIN_ID=30
# Image registry: PRIMARY (GHCR) that compose pulls from, plus the Docker Hub
# fallback the GUI uses when GHCR is degraded (the GUI manages both lines).
REGISTRY=ghcr.io/svendanilborodun
REGISTRY_FALLBACK=nettername
# Image tag compose runs. The GUI manages this line from docker/versions.env
# (the EDUBOTICS_IMAGE_TAG env var is the operator escape hatch) — hand edits
# are superseded on the next "Umgebung starten".
IMAGE_TAG=latest
EDUBOTICS_CAMERA_SOURCE=native_bridge

# Cloud Training (set these before building the physical_ai_manager image)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
CLOUD_API_URL=https://your-cloud-api.example.com
