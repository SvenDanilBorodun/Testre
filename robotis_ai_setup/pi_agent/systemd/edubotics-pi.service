[Unit]
Description=EduBotics Pi agent (management API + container lifecycle)
After=network-online.target docker.service
Wants=network-online.target docker.service
# Follow docker's lifecycle: PartOf propagates STOP and RESTART from
# docker.service to this unit, so `systemctl restart docker` restarts the agent
# too — which is what we want, because the agent's boot sequence re-brings-up the
# always-on manager and rebinds the ros_net gateway listener.
#
# PartOf does NOT propagate START (that is Requires=/Wants=, which we already
# have above for the boot path). So the one asymmetric case is a bare
# `systemctl stop docker`: that stops the agent as a systemd-REQUESTED stop, and
# a requested stop does not trigger Restart=always — the agent stays down until
# docker is started AND something starts the agent (a reboot, or an explicit
# `systemctl start edubotics-pi`). `systemctl restart docker` is fine; only the
# stop-then-start-later sequence strands it, and the System tab 502s meanwhile.
PartOf=docker.service

[Service]
Type=simple
# The managed .env is BOTH the compose interface AND this unit's EnvironmentFile
# (the Jetson precedent runs root with EnvironmentFile=/etc/edubotics/jetson.env;
# the Pi uses /etc/edubotics/.env — for a root systemd unit ~ is /root, not a
# user config dir). setup.sh (P4) creates it before the agent first runs.
#
# The leading `-` makes it OPTIONAL (audit L2). Without it, a missing or corrupted
# .env on a DEPLOYED (post-first-boot) Pi fails the unit BEFORE the agent process
# runs, so the agent's OWN self-seed branch (boot(): generate_cloud_only_env when
# the .env is absent) can never execute — there is zero self-heal, since
# first-boot's fallback writer only fires on a fresh golden clone. With `-`, systemd
# starts the agent even when the file is absent; the agent re-seeds a valid
# cloud-only .env and the next boot loads it normally. A present .env is loaded
# exactly as before, so this is a pure add-a-recovery-path change.
EnvironmentFile=-/etc/edubotics/.env
# The agent uses relative imports (from . import config_generator), so it MUST
# run as a PACKAGE module, not a bare script. WorkingDirectory puts the
# pi_agent/ package dir on sys.path[0] (python -m adds the cwd). setup.sh lays
# the tree out under /opt/edubotics accordingly.
WorkingDirectory=/opt/edubotics
Environment=PYTHONUNBUFFERED=1
# The agent writes /etc/edubotics/.env (holds HF_TOKEN). Default-deny group +
# other on every file this root unit creates so a regenerate can never leave the
# secret world-readable (belt-and-suspenders alongside the .env's explicit 0600).
UMask=0077
# Self-heal the self-update's accepted power-loss window: the staged swap is
# two renames (pi_agent -> pi_agent.old, pi_agent.new -> pi_agent), and a crash
# exactly between them leaves NO pi_agent/ while the complete previous tree
# sits in pi_agent.old. Restore it instead of crash-looping with no repair
# surface. The leading `-` makes the probe non-fatal on the normal boot where
# pi_agent/ exists (the `||` chain exits non-zero when there is nothing to do).
ExecStartPre=-/bin/sh -c '[ -d /opt/edubotics/pi_agent ] || { [ -d /opt/edubotics/pi_agent.old ] && mv /opt/edubotics/pi_agent.old /opt/edubotics/pi_agent; }'
ExecStart=/usr/bin/python3 -m pi_agent.agent
Restart=always
RestartSec=5
# The agent's teardown only closes its own HTTP listeners + phone/preview
# receivers (it NEVER runs `compose down` — the ros_net network + the always-on
# manager + any running robot tier must survive an agent restart), so shutdown
# is fast. 30s is a generous ceiling for the socket closes.
TimeoutStopSec=30
# Run as root: needs the docker socket + /dev (the scanner container mounts
# /dev; the robot tier runs privileged inside compose, not from here). The
# dialout/video group checks in the guided repairs are for interactive debug
# shells, not this root agent.
User=root
Group=root

# Journal logging — keeps `journalctl -u edubotics-pi` clean; the Protokoll SSE
# panel mirrors the same lines (redacted) from the agent's in-memory ring.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
